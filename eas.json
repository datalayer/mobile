{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "22.17.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_BUILD_PROFILE": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_BUILD_PROFILE": "development-simulator"
      }
    },
    "e2e": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_BUILD_PROFILE": "e2e",
        "EXPO_PUBLIC_DATALAYER_RUN_URL": "https://prod1.datalayer.run",
        "EXPO_PUBLIC_DATALAYER_RUNTIMES_URL": "https://r1.datalayer.run",
        "EXPO_PUBLIC_DATALAYER_MCP_URL": "https://mcp.datalayer.run"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_BUILD_PROFILE": "preview",
        "EXPO_PUBLIC_DATALAYER_RUN_URL": "https://prod1.datalayer.run",
        "EXPO_PUBLIC_DATALAYER_RUNTIMES_URL": "https://r1.datalayer.run",
        "EXPO_PUBLIC_DATALAYER_MCP_URL": "https://mcp.datalayer.run"
      }
    },
    "staging": {
      "extends": "base",
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_BUILD_PROFILE": "staging",
        "EXPO_PUBLIC_DATALAYER_RUN_URL": "https://prod1.datalayer.run",
        "EXPO_PUBLIC_DATALAYER_RUNTIMES_URL": "https://r1.datalayer.run",
        "EXPO_PUBLIC_DATALAYER_MCP_URL": "https://mcp.datalayer.run"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_DATALAYER_RUN_URL": "https://prod1.datalayer.run",
        "EXPO_PUBLIC_DATALAYER_RUNTIMES_URL": "https://r1.datalayer.run",
        "EXPO_PUBLIC_DATALAYER_MCP_URL": "https://mcp.datalayer.run"
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "ASC_APP_ID_PLACEHOLDER",
        "appleTeamId": "APPLE_TEAM_ID_PLACEHOLDER"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "ASC_APP_ID_PLACEHOLDER",
        "appleTeamId": "APPLE_TEAM_ID_PLACEHOLDER"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
