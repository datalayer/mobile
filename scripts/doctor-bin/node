# Doctor-only bridge; see ../run-expo-doctor.cjs. Command substitution strips
# trailing newlines, then printf restores one so spawn-async receives the full
# JavaScript child's stdout through a shell process.
set -o pipefail

output="$("${DATALAYER_DOCTOR_REAL_NODE:?}" "$@")"
status=$?

if [[ -n "${output}" ]]; then
  printf '%s\n' "${output}"
fi

exit "${status}"
